# Copy to backend/.env for local development, or to /etc/cac/cac.env (systemd) / ./.env (Docker).
# Every setting has a sensible default; only the ones marked REQUIRED matter in production.

# ----- General -----
ENVIRONMENT=development                  # development | production
SECRET_KEY=change-me                      # REQUIRED in production: python -c "import secrets; print(secrets.token_urlsafe(48))"
DATABASE_URL=sqlite:///./data/app.db      # e.g. mysql+pymysql://cac:pass@127.0.0.1/cac?charset=utf8mb4
                                          #   or postgresql+psycopg://cac:pass@127.0.0.1/cac
PUBLIC_BASE_URL=http://localhost:5173     # REQUIRED in production: used for links in emails
TIMEZONE=Asia/Shanghai
APP_NAME=CAC Share Sessions

# Docker Compose only
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# ----- Accounts -----
ALLOW_REGISTRATION=true
ALLOWED_EMAIL_DOMAINS=                    # e.g. smail.nju.edu.cn,nju.edu.cn (empty = any)
BOOTSTRAP_ADMIN_EMAILS=                   # these addresses become admins when they sign up or in
SESSION_TTL_HOURS=336

# ----- Scheduling rules -----
DAY_START=09:00
DAY_END=22:00
SLOT_MINUTES=30
REVIEWER_LIMIT=3
MEETUP_WEEKDAY=6                          # 0 = Monday ... 6 = Sunday
MEETUP_WINDOW_START=14:00
MEETUP_WINDOW_END=18:00
CLOSE_GRACE_MINUTES=1440                  # closing within this long after the end counts as on time
OBSERVER_RATING_WEIGHT=10

# ----- Participation watch -----
PARTICIPATION_LOOKBACK_DAYS=14
PARTICIPATION_REPORT_WEEKDAY=6
PARTICIPATION_REPORT_HOUR=22
PARTICIPATION_REPORT_EMAIL=               # summary recipient in addition to all admins
REVIEW_REMINDER_INTERVAL_HOURS=24

# ----- Email (leave SMTP_HOST empty to log emails instead of sending) -----
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=starttls                    # starttls | ssl | none
MAIL_FROM=
MAIL_FROM_NAME=CAC Share Sessions

# ----- Background jobs -----
RUN_SCHEDULER=false                       # true = run jobs inside the web process (single-process setups)
SCHEDULER_INTERVAL_SECONDS=60
